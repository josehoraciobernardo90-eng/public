{
  "name": "limpa-gondola-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "mobile": "npm --prefix mobile start",
    "build:apk": "npm --prefix mobile run build:apk",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "npm run build && node -e \"process.env.NODE_ENV='production'; process.env.PORT='3001'; require('./dist/server.cjs')\"",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "1.38.0",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "1.9.4",
    "lucide-react": "0.463.0",
    "motion": "^12.34.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.23.15",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "expo-module-scripts": "^56.0.3",
    "sharp": "^0.35.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
